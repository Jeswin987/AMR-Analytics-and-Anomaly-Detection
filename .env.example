# .env.example — copy to .env and fill in real values. Never commit .env.
# Placeholders only; nothing here is a working credential.

# ── PostgreSQL ──────────────────────────────────────────────────
# Required. SQLAlchemy connection URL; the app refuses to start without it.
DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/AMR_Prod
# Database user (informational; the URL above is what connects).
DB_USER=<db_user>
# Required. The app refuses to start without it.
DB_PASSWORD=<db_password>
# Database host (informational).
DB_HOST=localhost
# Database port (default 5432).
DB_PORT=5432
# Database name (informational).
DB_NAME=AMR_Prod

# ── InfluxDB ────────────────────────────────────────────────────
# InfluxDB base URL (default http://localhost:8086).
INFLUX_URL=http://localhost:8086
# Required in practice: API token with read access to the bucket below.
INFLUX_TOKEN=<influx_api_token>
# InfluxDB organization name.
INFLUX_ORG=<influx_org>
# Telemetry bucket (default device_core).
INFLUX_BUCKET=device_core

# ── Analytics ───────────────────────────────────────────────────
# Default look-back window for dashboard data, in hours (default 24).
HOURS_WINDOW=24

# ── Flask ───────────────────────────────────────────────────────
# true enables the interactive debugger; keep false outside local dev.
FLASK_DEBUG=false
# Bind address; 127.0.0.1 = this machine only (no auth exists).
FLASK_HOST=127.0.0.1
# HTTP port (default 5001).
FLASK_PORT=5001

# ── Health / readiness ──────────────────────────────────────────
# Per-request budget for /api/ready dependency probes, in seconds (default 2.0).
HEALTH_TIMEOUT_SECONDS=2.0
